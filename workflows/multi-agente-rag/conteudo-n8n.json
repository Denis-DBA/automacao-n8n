    {
      "parameters": {
        "jsCode": "const markdown = $input.first().json.data.markdown || \"\";\n\n// Remove os escapes do JSON\nconst text = markdown\n  .replace(/\\\\n/g, \"\\n\")\n  .replace(/\\\\r/g, \"\")\n  .replace(/\\\\t/g, \"\\t\");\n\n// Procura apenas links da documentação\nconst regex = /\\((https:\\/\\/docs\\.n8n\\.io\\/[^)\\s]+\\.md)\\)/g;\n\nconst urls = [];\nconst seen = new Set();\n\nlet match;\n\nwhile ((match = regex.exec(text)) !== null) {\n\n    let url = match[1];\n\n    // remove anchors\n    url = url.split(\"#\")[0];\n\n    // remove querystring\n    url = url.split(\"?\")[0];\n\n    // ignora páginas que não agregam\n    if (\n        url.endsWith(\"welcome.md\") ||\n        url.endsWith(\"llms.txt\")\n    ) {\n        continue;\n    }\n\n    if (!seen.has(url)) {\n\n        seen.add(url);\n\n        urls.push({\n            json: {\n                url\n            }\n        });\n\n    }\n\n}\n\nreturn urls;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
