    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// =====================================================\n// Obtém o markdown\n// =====================================================\n\nlet text = input.data?.markdown || input.markdown || input.content || \"\";\n\n// =====================================================\n// Desescapa caracteres do JSON\n// =====================================================\n\ntext = text\n    .replace(/\\\\n/g, \"\\n\")\n    .replace(/\\\\r/g, \"\")\n    .replace(/\\\\t/g, \"\\t\");\n\n// =====================================================\n// Remove o escape do Markdown\n// =====================================================\n\ntext = text.replace(/\\\\([#>*`\\[\\](){}_|-])/g, \"$1\");\n\n// =====================================================\n// Remove imagens\n// =====================================================\n\ntext = text.replace(/!\\[[^\\]]*?\\]\\([^)]+\\)/g, \"\");\n\n// =====================================================\n// Mantém somente o texto dos links\n// =====================================================\n\ntext = text.replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, \"$1\");\n\n// =====================================================\n// Remove URLs soltas\n// =====================================================\n\ntext = text.replace(/https?:\\/\\/\\S+/g, \"\");\n\n// =====================================================\n// Remove HTML\n// =====================================================\n\ntext = text.replace(/<[^>]*>/g, \"\");\n\n// =====================================================\n// Remove avisos do GitBook\n// =====================================================\n\nconst blacklist = [\n    \"For the complete documentation index\",\n    \"Markdown versions of documentation pages\",\n    \"Last updated\",\n    \"Was this helpful\",\n    \"AcceptReject\",\n    \"This site uses cookies\"\n];\n\ntext = text\n    .split(\"\\n\")\n    .filter(line => {\n\n        const t = line.trim();\n\n        if (!t) return false;\n\n        return !blacklist.some(item => t.includes(item));\n\n    })\n    .join(\"\\n\");\n\n// =====================================================\n// Normaliza espaços\n// =====================================================\n\ntext = text.replace(/[ \\t]+/g, \" \");\ntext = text.replace(/\\n{3,}/g, \"\\n\\n\");\n\n// =====================================================\n// Extrai H1\n// =====================================================\n\nlet title = \"\";\n\nconst h1 = text.match(/^#\\s+(.*)$/m);\n\nif (h1) {\n\n    title = h1[1].trim();\n\n    text = text.replace(/^#\\s+.*$/m, \"\").trim();\n\n}\n\n// =====================================================\n// Resultado\n// =====================================================\n\nreturn [{\n    json: {\n        technology: \"Power BI\",\n        url: input.data?.metadata?.url || input.url || \"\",\n        title,\n        content: text\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        272
      ],
      "id": "d42db1d3-9671-490d-837e-a81980dd1e33",
      "name": "Limpeza"
    },
    {
      "parameters": {
        "jsCode": "const markdown = $input.first().json.data.markdown || \"\";\n\n// Desescapa o Markdown retornado pelo Firecrawl\nconst text = markdown\n    .replace(/\\\\n/g, \"\\n\")\n    .replace(/\\\\r/g, \"\")\n    .replace(/\\\\t/g, \"\\t\");\n\n// Procura todos os links Markdown\nconst regex = /\\[([^\\]]+)\\]\\((https?:\\/\\/[^)\\s]+)\\)/g;\n\nconst urls = [];\nconst seen = new Set();\n\nlet match;\n\nwhile ((match = regex.exec(text)) !== null) {\n\n    let url = match[2].trim();\n\n    // Remove âncoras\n    url = url.split(\"#\")[0];\n\n    // Remove query string\n    url = url.split(\"?\")[0];\n\n    // Apenas documentação do Power BI\n    if (!url.startsWith(\"https://learn.microsoft.com/pt-br/power-bi/\")) {\n        continue;\n    }\n\n    // Ignora PDFs\n    if (url.endsWith(\".pdf\")) {\n        continue;\n    }\n\n    // Ignora imagens\n    if (/\\.(png|jpg|jpeg|gif|svg|webp)$/i.test(url)) {\n        continue;\n    }\n\n    if (!seen.has(url)) {\n        seen.add(url);\n\n        urls.push({\n            json: {\n                url\n            }\n        });\n    }\n}\n\nreturn urls;"
      },
