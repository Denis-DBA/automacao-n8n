    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// =====================================================\n// Obtém o markdown\n// =====================================================\n\nlet text = input.data?.markdown || input.markdown || input.content || \"\";\n\n// =====================================================\n// Desescapa caracteres do JSON\n// =====================================================\n\ntext = text\n    .replace(/\\\\n/g, \"\\n\")\n    .replace(/\\\\r/g, \"\")\n    .replace(/\\\\t/g, \"\\t\");\n\n// =====================================================\n// Remove o escape do Markdown\n// =====================================================\n\ntext = text.replace(/\\\\([#>*`\\[\\](){}_|-])/g, \"$1\");\n\n// =====================================================\n// Remove imagens\n// =====================================================\n\ntext = text.replace(/!\\[[^\\]]*?\\]\\([^)]+\\)/g, \"\");\n\n// =====================================================\n// Mantém somente o texto dos links\n// =====================================================\n\ntext = text.replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, \"$1\");\n\n// =====================================================\n// Remove URLs soltas\n// =====================================================\n\ntext = text.replace(/https?:\\/\\/\\S+/g, \"\");\n\n// =====================================================\n// Remove HTML\n// =====================================================\n\ntext = text.replace(/<[^>]*>/g, \"\");\n\n// =====================================================\n// Remove avisos do GitBook\n// =====================================================\n\nconst blacklist = [\n    \"For the complete documentation index\",\n    \"Markdown versions of documentation pages\",\n    \"Last updated\",\n    \"Was this helpful\",\n    \"AcceptReject\",\n    \"This site uses cookies\"\n];\n\ntext = text\n    .split(\"\\n\")\n    .filter(line => {\n\n        const t = line.trim();\n\n        if (!t) return false;\n\n        return !blacklist.some(item => t.includes(item));\n\n    })\n    .join(\"\\n\");\n\n// =====================================================\n// Normaliza espaços\n// =====================================================\n\ntext = text.replace(/[ \\t]+/g, \" \");\ntext = text.replace(/\\n{3,}/g, \"\\n\\n\");\n\n// =====================================================\n// Extrai H1\n// =====================================================\n\nlet title = \"\";\n\nconst h1 = text.match(/^#\\s+(.*)$/m);\n\nif (h1) {\n\n    title = h1[1].trim();\n\n    text = text.replace(/^#\\s+.*$/m, \"\").trim();\n\n}\n\n// =====================================================\n// Resultado\n// =====================================================\n\nreturn [{\n    json: {\n        technology: \"Power Automate\",\n        url: input.data?.metadata?.url || input.url || \"\",\n        title,\n        content: text\n    }\n}];"
      },
