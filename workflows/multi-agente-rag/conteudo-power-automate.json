    {
      "parameters": {
        "jsCode": "const markdown = $input.first().json.data.markdown || \"\";\n\n// Caso venha escapado (algumas versões do Firecrawl fazem isso)\nconst text = markdown\n  .replace(/\\\\r/g, \"\")\n  .replace(/\\\\n/g, \"\\n\")\n  .replace(/\\\\t/g, \"\\t\");\n\n// Regex simples e robusto para Markdown\nconst regex = /\\[(.*?)\\]\\((.*?)\\)/g;\n\nconst seen = new Set();\nconst output = [];\n\nlet match;\n\nwhile ((match = regex.exec(text)) !== null) {\n\n    const title = match[1].trim();\n\n    let url = match[2].trim();\n\n    // Remove âncoras\n    url = url.split(\"#\")[0];\n\n    // Remove query string\n    url = url.split(\"?\")[0];\n\n    // Apenas documentação do Power Automate\n    if (!url.startsWith(\"https://learn.microsoft.com/pt-br/power-automate/\")) {\n        continue;\n    }\n\n    // Ignora arquivos\n    if (/\\.(pdf|png|jpg|jpeg|gif|svg|webp)$/i.test(url)) {\n        continue;\n    }\n\n    // Remove páginas comerciais\n    if (\n        title.toLowerCase().includes(\"comprar\") ||\n        title.toLowerCase().includes(\"experimentar\")\n    ) {\n        continue;\n    }\n\n    // Remove páginas de treinamento\n    if (url.includes(\"/training/\")) {\n        continue;\n    }\n\n    // Remove duplicados\n    if (seen.has(url)) {\n        continue;\n    }\n\n    seen.add(url);\n\n    output.push({\n        json: {\n            title,\n            url\n        }\n    });\n\n}\n\nreturn output;"
      },
