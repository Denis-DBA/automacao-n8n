   "source": [
    "import cudf\n",
    "\n",
    "valores = cudf.Series([10, 20, 30], dtype=\"float64\")\n",
    "\n",
    "print(\"Soma:\", float(valores.sum()))\n",
    "print(\"Média:\", float(valores.mean()))\n",
    "print(\"Mínimo:\", float(valores.min()))\n",
    "print(\"Máximo:\", float(valores.max()))"
   ]
